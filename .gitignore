# dependencies
/node_modules

# next.js build output
/.next/
/out/

# capacitor native projects — android/ IS committed (it holds hand-edited
# native config like the AdMob AndroidManifest entry); its own
# android/.gitignore already excludes build output, .gradle, local.properties,
# copied web assets, etc. ios/ stays ignored until it actually exists.
/ios/

